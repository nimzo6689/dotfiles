[user]
    name = nimzo6689
    email = 14356595+nimzo6689@users.noreply.github.com
    signingkey = ~/.ssh/id_ed25519.pub
[init]
    defaultBranch = main
[core]
    editor = vim
    quotepath = false
    excludesfile = ~/.gitignore_global
[gpg]
    format = ssh
[commit]
    gpgsign = true
[merge]
    conflictStyle = zdiff3
[rebase]
    autoStash = true
[fetch]
    prune = true
[pull]
    rebase = true
[push]
    autoSetupRemote = true
[color]
    ui = auto
[diff]
    algorithm = histogram
[alias]
    st = status -sb
    diff = less -F -X
    graph = log --graph --date=format:'%Y-%m-%d %H:%M' --pretty=format:'%C(auto)%h%d %C(reset)%s %C(magenta)[%ad] %C(cyan)[%an]%C(reset)'
[help]
    autocorrect = 30
[hook "scan-credentials"]
	event = pre-commit
	command = ~/.config/git/hooks/pre-commit-scan-credentials.sh
[hook "check-large-files"]
	event = pre-commit
	command = ~/.config/git/hooks/pre-commit-check-large-files.sh
[hook "ensure-hook-installed"]
	event = pre-commit
	command = ~/.config/git/hooks/pre-commit-ensure-hook-installed.sh
